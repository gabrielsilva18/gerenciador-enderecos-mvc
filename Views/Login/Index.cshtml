@{
    ViewData["Title"] = "Login";
}

<div class="auth-page d-flex justify-content-center align-items-center py-2 py-md-4">
    <div class="card shadow-sm auth-card w-100 border-0">
        <div class="card-body p-4 p-md-5">
            <h2 class="text-center mb-4 h4 fw-semibold">Login</h2>

            <form method="post">
                <div class="mb-3">
                    <label class="form-label" for="loginNomeUsuario">Usuário</label>
                    <input type="text" name="nomeUsuario" id="loginNomeUsuario" class="form-control form-control-lg" placeholder="Digite seu usuário" autocomplete="username" />
                </div>

                <div class="mb-4">
                    <label class="form-label" for="loginSenha">Senha</label>
                    <div class="input-group input-group-lg">
                        <input type="password" name="senha" id="loginSenha" class="form-control" placeholder="Digite sua senha" autocomplete="current-password" />
                        <button type="button" class="btn btn-outline-secondary px-3" data-password-toggle="#loginSenha" aria-label="Mostrar senha" title="Mostrar ou ocultar senha">
                            <span class="js-password-icon" aria-hidden="true">👁️</span>
                        </button>
                    </div>
                </div>

                <button type="submit" class="btn btn-primary w-100 py-2">
                    Entrar
                </button>

                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger mt-3 mb-0 text-center small" role="alert">
                        @ViewBag.Error
                    </div>
                }

                <p class="text-center text-muted small mt-4 mb-0">
                    Não possui conta?
                    <a href="/Registro" class="text-decoration-none">Cadastre-se</a>
                </p>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/password-toggle.js" asp-append-version="true"></script>
}
