@model IEnumerable<GerenciadorEnderecos.Models.Endereco>

@{
    ViewData["Title"] = "Meus endereços";
}

<div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center page-header mb-4">
    <h1 class="h3 mb-0 page-title">Meus endereços</h1>
    <div class="d-flex flex-wrap gap-2">
        <a asp-action="ExportarCsv" class="btn btn-outline-success">Exportar CSV</a>
        <a asp-action="Create" class="btn btn-primary">Novo endereço</a>
    </div>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">Você ainda não cadastrou nenhum endereço.</div>
}
else
{
    <div class="table-responsive shadow-sm rounded bg-white">
        <table class="table table-striped table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>CEP</th>
                    <th>Logradouro</th>
                    <th>Nº</th>
                    <th>Bairro</th>
                    <th>Cidade</th>
                    <th>UF</th>
                    <th class="text-end">Ações</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Cep</td>
                        <td>@item.Logradouro</td>
                        <td>@item.Numero</td>
                        <td>@item.Bairro</td>
                        <td>@item.Cidade</td>
                        <td>@item.Uf</td>
                        <td class="text-end text-nowrap">
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Detalhes</a>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Excluir</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
