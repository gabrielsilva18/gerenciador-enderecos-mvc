@model GerenciadorEnderecos.Models.Endereco

@{
    ViewData["Title"] = "Detalhes do endereço";
}

<h1 class="h3 mb-4">Detalhes do endereço</h1>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card shadow-sm">
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-3">CEP</dt>
                    <dd class="col-sm-9">@Model.Cep</dd>

                    <dt class="col-sm-3">Logradouro</dt>
                    <dd class="col-sm-9">@Model.Logradouro</dd>

                    <dt class="col-sm-3">Número</dt>
                    <dd class="col-sm-9">@Model.Numero</dd>

                    <dt class="col-sm-3">Complemento</dt>
                    <dd class="col-sm-9">@(string.IsNullOrWhiteSpace(Model.Complemento) ? "—" : Model.Complemento)</dd>

                    <dt class="col-sm-3">Bairro</dt>
                    <dd class="col-sm-9">@Model.Bairro</dd>

                    <dt class="col-sm-3">Cidade</dt>
                    <dd class="col-sm-9">@Model.Cidade</dd>

                    <dt class="col-sm-3">UF</dt>
                    <dd class="col-sm-9">@Model.Uf</dd>
                </dl>
            </div>
            <div class="card-footer bg-transparent d-flex gap-2">
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Editar</a>
                <a asp-action="Index" class="btn btn-outline-secondary">Voltar à lista</a>
            </div>
        </div>
    </div>
</div>
