@model GerenciadorEnderecos.Models.Endereco

@{
    ViewData["Title"] = "Excluir endereço";
}

<h1 class="h3 mb-2 text-danger">Excluir endereço</h1>
<p class="text-muted mb-4">Tem certeza que deseja excluir este endereço? Esta ação não pode ser desfeita.</p>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card border-danger shadow-sm">
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-3">CEP</dt>
                    <dd class="col-sm-9">@Model.Cep</dd>

                    <dt class="col-sm-3">Endereço</dt>
                    <dd class="col-sm-9">@Model.Logradouro, @Model.Numero</dd>

                    <dt class="col-sm-3">Bairro / Cidade</dt>
                    <dd class="col-sm-9">@Model.Bairro — @Model.Cidade / @Model.Uf</dd>
                </dl>
            </div>
            <div class="card-footer bg-transparent">
                <form asp-action="Delete" method="post">
                    <input type="hidden" asp-for="Id" />
                    <button type="submit" class="btn btn-danger">Excluir</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                </form>
            </div>
        </div>
    </div>
</div>
