@model GerenciadorEnderecos.Models.Usuario

@{
ViewData["Title"] = "Cadastro";
}

<div class="container d-flex justify-content-center align-items-center vh-100">

	<div class="card shadow p-4" style="width: 400px; border-radius: 15px;">

		<h2 class="text-center mb-4">Cadastro</h2>

		<form asp-action="Index" method="post">

			<div class="mb-3">
				<label asp-for="Nome" class="form-label"></label>
				<input asp-for="Nome" class="form-control" />
			</div>

			<div class="mb-3">
				<label asp-for="NomeUsuario" class="form-label"></label>
				<input asp-for="NomeUsuario" class="form-control" />
			</div>

			<div class="mb-3">
				<label asp-for="Senha" class="form-label"></label>
				<input asp-for="Senha" type="password" class="form-control" />
			</div>

			<button type="submit" class="btn btn-success w-100">
				Cadastrar
			</button>

			<div class="text-center mt-3">
				<p class="mb-0">
					Já possui conta?
					<a href="/Login">Faça login</a>
				</p>
			</div>

		</form>

	</div>

</div>